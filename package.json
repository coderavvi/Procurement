{
  "name": "blockchain-etendering-mvp",
  "version": "1.0.0",
  "description": "Blockchain-Enabled E-Tendering System for PhD Research",
  "main": "hardhat.config.js",
  "scripts": {
    "start": "powershell -ExecutionPolicy Bypass -File start.ps1",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "seed": "hardhat run scripts/seed.js --network localhost",
    "server": "node server/server.js",
    "client": "npm --prefix client run dev"
  },
  "keywords": [
    "blockchain",
    "e-tendering",
    "smart-contracts",
    "solidity",
    "hardhat",
    "ethers"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "ethers": "^6.13.5",
    "hardhat": "^2.22.18",
    "pdfkit": "^0.20.1"
  }
}
